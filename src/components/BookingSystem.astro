---
import ServiceCard from "./ServiceCard.astro";
import CalendarPicker from "./CalendarPicker.astro";
import TimeSlots from "./TimeSlots.astro";

const services = [
  {
    id: "corte-cejas",
    name: "Corte de Pelo + Cejas",
    price: 13000,
    discountPrice: 12000,
    duration: "40 min",
    description: "Cejas opcionales",
  },
  {
    id: "corte-cejas-barba",
    name: "Corte de Pelo + Barba",
    price: 15000,
    duration: "40 min",
  },
  {
    id: "perfilado-barba",
    name: "Perfilado de barba",
    price: 7000,
    duration: "5 min",
  },
  {
    id: "perfilado-cejas",
    name: "Perfilado de Cejas",
    price: 4000,
    duration: "3 min",
  },
  {
    id: "corte-mechas",
    name: "Corte de Pelo + Mechas",
    price: 50000,
    duration: "2h",
  },
  {
    id: "corte-global",
    name: "Corte de Pelo + Global",
    price: 65000,
    duration: "3h",
  },
];
---

<section id="servicios" class="w-full max-w-4xl mx-auto px-4 py-8">
  <div class="text-center mb-8">
    <h2 class="text-3xl font-bold text-gray-800 mb-2">Reserva tu turno</h2>
    <p class="text-gray-600">Agregá uno o más servicios al carrito</p>
  </div>

  <!-- Progress Indicator -->
  <div class="flex items-center justify-center mb-8 gap-2">
    <div id="step-1" class="flex flex-col items-center gap-1 text-gray-800 transition-colors" data-step="1">
      <span class="w-8 h-8 rounded-full border-2 flex items-center justify-center text-sm font-bold transition-all border-gray-800 bg-gray-800 text-white">1</span>
      <span class="text-xs font-medium">Servicios</span>
    </div>
    <div class="w-12 h-0.5 bg-gray-300 mx-2"></div>
    <div id="step-2" class="flex flex-col items-center gap-1 text-gray-400 transition-colors" data-step="2">
      <span class="w-8 h-8 rounded-full border-2 flex items-center justify-center text-sm font-bold transition-all border-gray-300">2</span>
      <span class="text-xs font-medium">Fecha</span>
    </div>
    <div class="w-12 h-0.5 bg-gray-300 mx-2"></div>
    <div id="step-3" class="flex flex-col items-center gap-1 text-gray-400 transition-colors" data-step="3">
      <span class="w-8 h-8 rounded-full border-2 flex items-center justify-center text-sm font-bold transition-all border-gray-300">3</span>
      <span class="text-xs font-medium">Horarios</span>
    </div>
  </div>

  <!-- Services Grid -->
  <div id="services-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 animate-fade-in">
    {services.map((service) => (
      <ServiceCard
        id={service.id}
        name={service.name}
        price={service.price}
        discountPrice={(service as any).discountPrice}
        duration={service.duration}
        description={service.description}
      />
    ))}
  </div>

  <!-- Carrito flotante (aparece cuando hay items) -->
  <div id="cart-bar" class="hidden fixed bottom-0 left-0 right-0 z-40 bg-gray-900 text-white shadow-2xl border-t border-gray-700 animate-slide-in-bottom">
    <div class="max-w-4xl mx-auto px-4 py-3 flex items-center justify-between gap-3">
      <div class="flex items-center gap-3 min-w-0">
        <div class="flex items-center justify-center w-8 h-8 rounded-full bg-gray-700 text-white text-sm font-bold shrink-0">
          <span id="cart-count">0</span>
        </div>
        <div class="min-w-0">
          <p class="text-xs text-gray-400">Total estimado</p>
          <p id="cart-total" class="text-lg font-bold truncate">$0</p>
        </div>
      </div>
      <div class="flex gap-2 shrink-0">
        <button id="cart-clear" class="px-3 py-2 rounded-lg bg-gray-700 hover:bg-gray-600 text-sm transition-colors">
          Vaciar
        </button>
        <button id="cart-checkout" class="px-4 py-2 rounded-lg bg-white text-gray-900 font-semibold hover:bg-gray-100 text-sm transition-colors flex items-center gap-2">
          Continuar
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <!-- Calendar Picker -->
  <CalendarPicker />

  <!-- Time Slots (multi-servicio) -->
  <TimeSlots />

  <!-- Confirmation Modal -->
  <div id="confirmation-modal" class="hidden fixed inset-0 bg-black/50 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl shadow-2xl max-w-md w-full p-6 animate-fade-in animate-duration-200 max-h-[90vh] overflow-y-auto">
      <h3 class="text-xl font-bold text-gray-800 mb-4 flex items-center gap-2">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6 text-green-600" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2" />
        </svg>
        Confirmar reserva
      </h3>
      <div id="booking-summary" class="space-y-3 mb-6">
        <!-- Summary rendered by JS -->
      </div>
      <div class="flex gap-3">
        <button id="cancel-booking" class="flex-1 py-3 px-4 rounded-lg border-2 border-gray-300 text-gray-700 font-medium hover:bg-gray-50 transition-colors">
          Cancelar
        </button>
        <button id="confirm-booking" class="flex-1 py-3 px-4 rounded-lg bg-green-600 text-white font-medium hover:bg-green-700 transition-colors flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>
          Confirmar por WhatsApp
        </button>
      </div>
    </div>
  </div>

  <!-- Admin Panel -->
  <div id="admin-panel" class="hidden fixed inset-0 bg-black/60 backdrop-blur-sm z-50 flex items-end sm:items-center justify-center p-0 sm:p-4">
    <div class="bg-white rounded-t-3xl sm:rounded-2xl shadow-2xl max-w-2xl w-full max-h-[92vh] sm:max-h-[85vh] overflow-hidden animate-fade-in flex flex-col">

      <!-- Header -->
      <div class="px-6 pt-6 pb-4 bg-gray-900 text-white flex justify-between items-start shrink-0">
        <div>
          <div class="flex items-center gap-2 mb-1">
            <span class="text-lg">⚙️</span>
            <h3 class="text-lg font-bold">Panel de Administración</h3>
          </div>
          <p class="text-xs text-gray-400">KMZ Studio · Turnos</p>
        </div>
        <button id="close-admin" class="text-gray-400 hover:text-white transition-colors mt-1">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Stats bar -->
      <div id="admin-stats" class="flex gap-0 border-b border-gray-100 shrink-0 bg-gray-50">
        <div class="flex-1 px-4 py-3 text-center border-r border-gray-100">
          <p id="stat-total" class="text-xl font-black text-gray-900">–</p>
          <p class="text-[10px] text-gray-500 uppercase tracking-wide">Hoy</p>
        </div>
        <div class="flex-1 px-4 py-3 text-center border-r border-gray-100">
          <p id="stat-upcoming" class="text-xl font-black text-gray-900">–</p>
          <p class="text-[10px] text-gray-500 uppercase tracking-wide">Próximos</p>
        </div>
        <div class="flex-1 px-4 py-3 text-center">
          <p id="stat-multi" class="text-xl font-black text-gray-900">–</p>
          <p class="text-[10px] text-gray-500 uppercase tracking-wide">Multi-serv.</p>
        </div>
      </div>

      <!-- Filter tabs -->
      <div class="flex gap-1 px-4 py-2 border-b border-gray-100 shrink-0 bg-white">
        <button class="admin-tab active-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all bg-gray-900 text-white" data-tab="all">Todos</button>
        <button class="admin-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-gray-500 hover:bg-gray-100" data-tab="today">Hoy</button>
        <button class="admin-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-gray-500 hover:bg-gray-100" data-tab="upcoming">Próximos</button>
        <button class="admin-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all text-gray-500 hover:bg-gray-100" data-tab="multi">Multi-serv.</button>
      </div>

      <!-- Bookings list -->
      <div class="flex-1 overflow-y-auto p-4">
        <div id="admin-bookings" class="space-y-2"></div>
        <div id="no-bookings" class="hidden text-center text-gray-400 py-12">
          <div class="text-4xl mb-3">📭</div>
          <p class="font-medium text-gray-500">No hay turnos</p>
          <p class="text-sm text-gray-400 mt-1">Los turnos pasados se eliminan automáticamente</p>
        </div>
      </div>

      <!-- Footer -->
      <div class="p-4 border-t border-gray-100 bg-gray-50 shrink-0">
        <button id="clear-all-bookings" class="w-full py-2.5 px-4 rounded-xl border-2 border-red-200 text-red-600 font-medium hover:bg-red-50 transition-colors text-sm flex items-center justify-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
          </svg>
          Limpiar todos los turnos
        </button>
      </div>
    </div>
  </div>
</section>

<!-- Admin Access -->
<div id="admin-trigger" class="fixed bottom-4 right-4 opacity-0 hover:opacity-100 transition-opacity z-30">
  <button id="open-admin" class="text-xs text-gray-400 hover:text-gray-600">Admin</button>
</div>


<script>
  import { initializeApp } from 'firebase/app';
  import { getFirestore, collection, getDocs, addDoc, deleteDoc, query, where, onSnapshot } from 'firebase/firestore';

  // ========== FIREBASE SETUP ==========
  const firebaseConfig = {
    apiKey: import.meta.env.PUBLIC_FIREBASE_API_KEY,
    authDomain: import.meta.env.PUBLIC_FIREBASE_AUTH_DOMAIN,
    projectId: import.meta.env.PUBLIC_FIREBASE_PROJECT_ID,
    storageBucket: import.meta.env.PUBLIC_FIREBASE_STORAGE_BUCKET,
    messagingSenderId: import.meta.env.PUBLIC_FIREBASE_MESSAGING_SENDER_ID,
    appId: import.meta.env.PUBLIC_FIREBASE_APP_ID,
  };
  const firebaseApp = initializeApp(firebaseConfig);
  const db = getFirestore(firebaseApp);

  // ========== BOOKING SYSTEM ==========

  const MORNING_SLOTS = [
    { start: "10:00", end: "10:40" },
    { start: "10:40", end: "11:20" },
    { start: "11:20", end: "12:00" },
  ];
  const AFTERNOON_SLOTS = [
    { start: "14:00", end: "14:40" },
    { start: "14:40", end: "15:20" },
    { start: "15:20", end: "16:00" },
    { start: "16:00", end: "16:40" },
    { start: "16:40", end: "17:20" },
    { start: "17:20", end: "18:00" },
    { start: "18:00", end: "18:40" },
    { start: "18:40", end: "19:20" },
    { start: "19:20", end: "20:00" },
  ];
  const ALL_SLOTS = [...MORNING_SLOTS, ...AFTERNOON_SLOTS];

  const WHATSAPP_NUMBER = "5492226532910";
  const ADMIN_PASSWORD = "kmz2024";

  // ========== ESTADO DEL CARRITO ==========
  // cart: array de { id, name, price, duration }
  // cartSlots: array de { serviceIndex, time } — un slot por item del carrito
  interface CartItem { id: string; name: string; price: number; discountPrice?: number; duration: string; }
  interface CartSlot { serviceIndex: number; time: string; }

  let cart: CartItem[] = [];
  let cartSlots: CartSlot[] = []; // slots asignados a cada item del carrito
  let selectedDate: Date | null = null;
  let currentSlotIndex: number = 0; // índice del item del carrito al que estamos asignando horario

  // ========== FIREBASE FUNCTIONS ==========
  async function getBookings(): Promise<Array<{id: string; fecha: string; hora: string; servicio: string}>> {
    try {
      const snapshot = await getDocs(collection(db, 'turnos'));
      return snapshot.docs.map(d => ({ id: d.id, ...(d.data() as {fecha: string; hora: string; servicio: string}) }));
    } catch { return []; }
  }

  async function saveBooking(fecha: string, hora: string, servicio: string): Promise<boolean> {
    try {
      await addDoc(collection(db, 'turnos'), { fecha, hora, servicio });
      return true;
    } catch { return false; }
  }

  async function removeBooking(fecha: string, hora: string): Promise<boolean> {
    try {
      const q = query(collection(db, 'turnos'), where('fecha', '==', fecha), where('hora', '==', hora));
      const snapshot = await getDocs(q);
      for (const d of snapshot.docs) await deleteDoc(d.ref);
      return true;
    } catch { return false; }
  }

  async function clearAllBookings(): Promise<boolean> {
    try {
      const snapshot = await getDocs(collection(db, 'turnos'));
      for (const d of snapshot.docs) await deleteDoc(d.ref);
      return true;
    } catch { return false; }
  }

  // ========== REALTIME ==========
  onSnapshot(collection(db, 'turnos'), () => {
    if (selectedDate) renderTimeSlots(selectedDate);
  });

  // ========== DESCUENTO LUN/MAR ==========
  function isDiscountDay(date: Date | null): boolean {
    if (!date) return false;
    const day = date.getDay(); // 0=Dom, 1=Lun, 2=Mar
    return day === 1 || day === 2;
  }

  function getItemPrice(item: CartItem, date: Date | null): number {
    if (isDiscountDay(date) && item.discountPrice) return item.discountPrice;
    return item.price;
  }

  // ========== UTILS ==========
  function formatDate(date: Date): string {
    const days = ["Domingo","Lunes","Martes","Miércoles","Jueves","Viernes","Sábado"];
    const months = ["Enero","Febrero","Marzo","Abril","Mayo","Junio","Julio","Agosto","Septiembre","Octubre","Noviembre","Diciembre"];
    return `${days[date.getDay()]} ${date.getDate()} de ${months[date.getMonth()]}`;
  }

  function formatDateStorage(date: Date): string {
    const y = date.getFullYear();
    const m = String(date.getMonth() + 1).padStart(2, '0');
    const d = String(date.getDate()).padStart(2, '0');
    return `${y}-${m}-${d}`;
  }

  function updateSteps(currentStep: number) {
    for (let i = 1; i <= 3; i++) {
      const step = document.getElementById(`step-${i}`);
      if (!step) continue;
      const num = step.querySelector("span:first-child");
      step.classList.remove("text-gray-800","text-green-600","text-gray-400");
      num?.classList.remove("border-gray-800","bg-gray-800","text-white","border-green-600","bg-green-600","border-gray-300");
      if (i < currentStep) {
        step.classList.add("text-green-600");
        num?.classList.add("border-green-600","bg-green-600","text-white");
      } else if (i === currentStep) {
        step.classList.add("text-gray-800");
        num?.classList.add("border-gray-800","bg-gray-800","text-white");
      } else {
        step.classList.add("text-gray-400");
        num?.classList.add("border-gray-300");
      }
    }
  }

  function showSection(sec: "services" | "calendar" | "timeslots") {
    document.getElementById("services-grid")?.classList.add("hidden");
    document.getElementById("cart-bar")?.classList.add("hidden");
    document.getElementById("calendar-picker")?.classList.add("hidden");
    document.getElementById("time-slots")?.classList.add("hidden");

    if (sec === "services") {
      document.getElementById("services-grid")?.classList.remove("hidden");
      updateCartBar(); // muestra/oculta el carrito
      updateSteps(1);
    } else if (sec === "calendar") {
      document.getElementById("calendar-picker")?.classList.remove("hidden");
      renderCalendar();
      updateSteps(2);
    } else if (sec === "timeslots") {
      document.getElementById("time-slots")?.classList.remove("hidden");
      if (selectedDate) renderTimeSlots(selectedDate);
      updateSteps(3);
    }
  }

  // ========== CARRITO ==========
  function updateCartBar() {
    const bar = document.getElementById("cart-bar");
    const countEl = document.getElementById("cart-count");
    const totalEl = document.getElementById("cart-total");
    if (!bar || !countEl || !totalEl) return;

    if (cart.length === 0) {
      bar.classList.add("hidden");
    } else {
      bar.classList.remove("hidden");
      countEl.textContent = String(cart.length);
      const total = cart.reduce((sum, item) => sum + item.price, 0);
      totalEl.textContent = `$${total.toLocaleString("es-AR")}`;
    }

    // Actualizar badges en las cards
    document.querySelectorAll(".service-card").forEach((card) => {
      const el = card as HTMLElement;
      const id = el.dataset.serviceId || "";
      const count = cart.filter(i => i.id === id).length;
      const badge = el.querySelector(".service-cart-badge") as HTMLElement | null;
      if (badge) {
        if (count > 0) {
          badge.textContent = String(count);
          badge.classList.remove("hidden");
          badge.classList.add("flex");
          el.dataset.selected = "true";
        } else {
          badge.classList.add("hidden");
          badge.classList.remove("flex");
          el.dataset.selected = "false";
        }
      }
    });
  }

  function addToCart(item: CartItem) {
    cart.push(item);
    updateCartBar();
  }

  function clearCart() {
    cart = [];
    cartSlots = [];
    currentSlotIndex = 0;
    updateCartBar();
  }

  // ========== CALENDAR ==========
  function renderCalendar() {
    const container = document.getElementById("calendar-days");
    if (!container) return;
    container.innerHTML = "";
    const today = new Date();
    const days = ["DOM","LUN","MAR","MIÉ","JUE","VIE","SÁB"];
    const months = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];

    for (let i = 0; i < 7; i++) {
      const date = new Date(today);
      date.setDate(today.getDate() + i);
      const isToday = i === 0;
      const isDiscountDayVal = date.getDay() === 1 || date.getDay() === 2; // Lun o Mar

      const dayCard = document.createElement("div");
      dayCard.className = [
        "flex flex-col items-center justify-center",
        "min-w-[85px] min-h-[100px] p-4 rounded-2xl cursor-pointer",
        "transition-all duration-300 ease-out hover:scale-110 hover:shadow-xl",
        isToday
          ? "bg-gradient-to-br from-gray-700 to-gray-800 text-white shadow-lg border-2 border-gray-600"
          : isDiscountDayVal
            ? "bg-gradient-to-br from-green-50 to-green-100 border-2 border-green-400 hover:border-green-500"
            : "bg-gradient-to-br from-gray-100 to-gray-200 border-2 border-gray-300 hover:border-gray-500"
      ].join(" ");
      dayCard.dataset.date = formatDateStorage(date);

      const dayNameColor = isToday ? 'text-gray-300' : isDiscountDayVal ? 'text-green-600' : 'text-gray-500';
      const dateNumColor = isToday ? 'text-white' : isDiscountDayVal ? 'text-green-800' : 'text-gray-800';
      const monthColor = isToday ? 'text-gray-300' : isDiscountDayVal ? 'text-green-600' : 'text-gray-500';

      dayCard.innerHTML = `
        <span class="text-xs font-bold uppercase tracking-wider ${dayNameColor}">${days[date.getDay()]}</span>
        <span class="text-3xl font-black ${dateNumColor}">${date.getDate()}</span>
        <span class="text-sm font-medium ${monthColor}">${months[date.getMonth()]}</span>
        ${isToday ? '<span class="text-[10px] mt-1 bg-white/20 px-2 py-0.5 rounded-full">HOY</span>' : ''}
        ${isDiscountDayVal ? '<span class="text-[10px] mt-1 bg-green-500 text-white px-2 py-0.5 rounded-full font-bold">PROMO</span>' : ''}
      `;

      dayCard.addEventListener("click", () => {
        container.querySelectorAll("[data-date]").forEach((c) => {
          const ce = c as HTMLElement;
          const cIsToday = ce.dataset.date === formatDateStorage(today);
          ce.className = [
            "flex flex-col items-center justify-center min-w-[85px] min-h-[100px] p-4 rounded-2xl cursor-pointer",
            "transition-all duration-300 ease-out hover:scale-110 hover:shadow-xl",
            cIsToday
              ? "bg-gradient-to-br from-gray-700 to-gray-800 text-white shadow-lg border-2 border-gray-600"
              : "bg-gradient-to-br from-gray-100 to-gray-200 border-2 border-gray-300 hover:border-gray-500"
          ].join(" ");
        });
        dayCard.className = "flex flex-col items-center justify-center min-w-[85px] min-h-[100px] p-4 rounded-2xl cursor-pointer transition-all duration-300 ease-out bg-gradient-to-br from-gray-800 to-gray-900 text-white shadow-2xl border-2 border-gray-700 scale-105";
        selectedDate = date;
        cartSlots = [];
        currentSlotIndex = 0;
        showSection("timeslots");
      });

      container.appendChild(dayCard);
    }
  }

  // ========== TIME SLOTS (multi-servicio) ==========
  async function renderTimeSlots(date: Date) {
    const morningContainer = document.getElementById("morning-slots");
    const afternoonContainer = document.getElementById("afternoon-slots");
    const dateDisplay = document.getElementById("selected-date-display");
    const slotTitle = document.getElementById("slot-service-title");
    const slotProgress = document.getElementById("slot-progress");

    if (!morningContainer || !afternoonContainer) return;

    // Titulo del servicio actual que necesita horario
    if (slotTitle) {
      const current = cart[currentSlotIndex];
      slotTitle.textContent = current
        ? `Elegí horario para: ${current.name} (${currentSlotIndex + 1} de ${cart.length})`
        : "";
    }

    // Progresito de servicios
    if (slotProgress) {
      slotProgress.innerHTML = cart.map((item, idx) => {
        const assigned = cartSlots.find(s => s.serviceIndex === idx);
        const isCurrent = idx === currentSlotIndex;
        return `<div class="flex items-center gap-1.5 text-xs ${isCurrent ? 'font-bold text-gray-800' : assigned ? 'text-green-600' : 'text-gray-400'}">
          <span class="w-5 h-5 rounded-full flex items-center justify-center border ${isCurrent ? 'border-gray-800 bg-gray-800 text-white' : assigned ? 'border-green-500 bg-green-500 text-white' : 'border-gray-300'}">
            ${assigned ? '✓' : idx + 1}
          </span>
          <span class="hidden sm:inline truncate max-w-[100px]">${item.name}</span>
        </div>`;
      }).join('<div class="w-4 h-0.5 bg-gray-300 mx-0.5"></div>');
    }

    if (dateDisplay) dateDisplay.textContent = formatDate(date);

    const dateStr = formatDateStorage(date);
    morningContainer.innerHTML = '<div class="col-span-full text-center text-gray-500 py-4">Cargando...</div>';
    afternoonContainer.innerHTML = '';

    const q = query(collection(db, 'turnos'), where('fecha', '==', dateStr));
    const snapshot = await getDocs(q);
    const bookedHours = new Set(snapshot.docs.map(d => d.data().hora as string));
    // También tachar los slots ya asignados a otros servicios del carrito
    const assignedHours = new Set(cartSlots.map(s => s.time));

    morningContainer.innerHTML = "";
    MORNING_SLOTS.forEach((slot) => {
      const isBooked = bookedHours.has(slot.start);
      const isAssigned = assignedHours.has(slot.start);
      morningContainer.appendChild(createSlotElement(slot.start, slot.end, isBooked, isAssigned));
    });

    afternoonContainer.innerHTML = "";
    AFTERNOON_SLOTS.forEach((slot) => {
      const isBooked = bookedHours.has(slot.start);
      const isAssigned = assignedHours.has(slot.start);
      afternoonContainer.appendChild(createSlotElement(slot.start, slot.end, isBooked, isAssigned));
    });
  }

  function createSlotElement(start: string, end: string, isBooked: boolean, isAssigned: boolean): HTMLElement {
    const slot = document.createElement("button");
    const base = "flex flex-col items-center justify-center py-3 px-2 rounded-lg border-2 font-medium transition-all duration-200 ease-out text-sm";

    if (isBooked) {
      slot.className = `${base} bg-gray-100 border-gray-200 text-gray-400 cursor-not-allowed line-through`;
      slot.disabled = true;
    } else if (isAssigned) {
      // Slot ya elegido para otro servicio del carrito
      const serviceIdx = cartSlots.find(s => s.time === start)?.serviceIndex ?? -1;
      const serviceName = serviceIdx >= 0 ? cart[serviceIdx]?.name.split(" ")[0] : "";
      slot.className = `${base} bg-amber-50 border-amber-400 text-amber-700 cursor-not-allowed`;
      slot.disabled = true;
      slot.innerHTML = `<span class="line-through opacity-60">${start} - ${end}</span><span class="text-[10px] mt-0.5 text-amber-600">${serviceName}</span>`;
    } else {
      slot.className = `${base} bg-white border-gray-200 text-gray-700 cursor-pointer hover:scale-105 hover:shadow-md hover:border-gray-400`;
      slot.textContent = `${start} - ${end}`;
      slot.addEventListener("click", () => onSlotClick(start));
    }

    if (!isBooked && !isAssigned) slot.dataset.time = start;
    return slot;
  }

  function onSlotClick(time: string) {
    // Asignar este horario al servicio actual
    cartSlots = cartSlots.filter(s => s.serviceIndex !== currentSlotIndex);
    cartSlots.push({ serviceIndex: currentSlotIndex, time });

    // ¿Hay más servicios sin horario?
    const nextUnassigned = cart.findIndex((_, idx) =>
      idx > currentSlotIndex && !cartSlots.find(s => s.serviceIndex === idx)
    );

    if (nextUnassigned !== -1) {
      // Pasar al siguiente servicio
      currentSlotIndex = nextUnassigned;
      if (selectedDate) renderTimeSlots(selectedDate);
    } else {
      // Todos los servicios tienen horario → mostrar resumen
      showConfirmationModal();
    }
  }

  // ========== MODAL CONFIRMACIÓN ==========
  function showConfirmationModal() {
    const modal = document.getElementById("confirmation-modal");
    const summary = document.getElementById("booking-summary");
    if (!modal || !summary || !selectedDate) return;

    const discount = isDiscountDay(selectedDate);
    const totalPrice = cart.reduce((sum, item) => sum + getItemPrice(item, selectedDate), 0);

    summary.innerHTML = `
      <div class="bg-gray-50 rounded-xl p-3 mb-3">
        <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide mb-2">📅 Fecha</p>
        <p class="font-medium text-gray-800">${formatDate(selectedDate)}</p>
        ${discount ? '<p class="text-xs text-green-600 font-semibold mt-1">🏷️ Descuento Lunes/Martes aplicado</p>' : ''}
      </div>
      <div class="space-y-2">
        ${cart.map((item, idx) => {
          const slot = cartSlots.find(s => s.serviceIndex === idx);
          const slotInfo = ALL_SLOTS.find(s => s.start === slot?.time);
          const finalPrice = getItemPrice(item, selectedDate);
          const hasDiscount = discount && item.discountPrice && item.discountPrice < item.price;
          return `
            <div class="flex justify-between items-start py-2 border-b border-gray-100 last:border-0">
              <div>
                <p class="font-medium text-gray-800 text-sm">${item.name}</p>
                <p class="text-xs text-gray-500">⏰ ${slot?.time || '?'} - ${slotInfo?.end || '?'}</p>
              </div>
              <div class="text-right">
                ${hasDiscount ? `<span class="text-xs text-gray-400 line-through">$${item.price.toLocaleString("es-AR")}</span>` : ''}
                <span class="font-bold ${hasDiscount ? 'text-green-600' : 'text-gray-900'} text-sm">$${finalPrice.toLocaleString("es-AR")}</span>
              </div>
            </div>
          `;
        }).join("")}
      </div>
      <div class="flex justify-between items-center pt-3 mt-2 border-t-2 border-gray-200">
        <span class="font-bold text-gray-700">Total</span>
        <span class="text-xl font-black text-gray-900">$${totalPrice.toLocaleString("es-AR")}</span>
      </div>
    `;

    modal.classList.remove("hidden");
  }

  function hideConfirmationModal() {
    document.getElementById("confirmation-modal")?.classList.add("hidden");
  }

  // ========== CONFIRMAR Y ENVIAR WS ==========
  async function confirmBooking() {
    if (!selectedDate || cart.length === 0 || cartSlots.length !== cart.length) return;

    const dateStr = formatDateStorage(selectedDate);
    const formattedDate = formatDate(selectedDate);

    // Armar mensaje WS antes de los awaits (iOS)
    const discount = isDiscountDay(selectedDate);
    const lines = cart.map((item, idx) => {
      const slot = cartSlots.find(s => s.serviceIndex === idx);
      const price = getItemPrice(item, selectedDate);
      return `• ${item.name} a las ${slot?.time || '?'} ($${price.toLocaleString("es-AR")})`;
    }).join('\n');
    const totalPrice = cart.reduce((sum, item) => sum + getItemPrice(item, selectedDate), 0);
    const message = encodeURIComponent(
      `Hola! Quiero reservar los siguientes turnos para el ${formattedDate}:\n${lines}\nTotal: $${totalPrice.toLocaleString("es-AR")}${discount ? ' (descuento Lun/Mar)' : ''}\nMi nombre es:`
    );
    const whatsappUrl = `https://wa.me/${WHATSAPP_NUMBER}?text=${message}`;

    const confirmBtn = document.getElementById("confirm-booking");
    const originalContent = confirmBtn?.innerHTML || '';
    if (confirmBtn) {
      confirmBtn.textContent = "Guardando...";
      confirmBtn.setAttribute("disabled", "true");
    }

    // Guardar todos los turnos en Supabase
    const allServices = cart.map(item => item.name).join(" + ");
    let allOk = true;
    for (const slot of cartSlots) {
      const ok = await saveBooking(dateStr, slot.time, cart[slot.serviceIndex]?.name || allServices);
      if (!ok) { allOk = false; break; }
    }

    if (!allOk) {
      alert("Error al guardar el turno. Intenta de nuevo.");
      if (confirmBtn) {
        confirmBtn.innerHTML = originalContent;
        confirmBtn.removeAttribute("disabled");
      }
      return;
    }

    // Turno guardado exitosamente — re-renderizar los slots para que se vean tachados
    if (selectedDate) await renderTimeSlots(selectedDate);

    hideConfirmationModal();
    if (confirmBtn) {
      confirmBtn.innerHTML = originalContent;
      confirmBtn.removeAttribute("disabled");
    }

    // Mostrar la vista de horarios con los slots recién tachados antes de abrir WhatsApp
    showSection("timeslots");

    // Limpiar estado del carrito pero mantener selectedDate para que onSnapshot siga funcionando
    cart = [];
    cartSlots = [];
    currentSlotIndex = 0;
    updateCartBar();

    // Abrir WhatsApp después de un breve delay para que el usuario vea el slot tachado
    setTimeout(() => {
      selectedDate = null;
      showSection("services");
      window.location.href = whatsappUrl;
    }, 500);
  }

  // ========== ADMIN ==========
  let adminAuthenticated = false;
  let adminCurrentTab = "all";
  let adminAllBookings: Array<{fecha: string; hora: string; servicio: string}> = [];

  function getNowArgentina(): { dateStr: string; timeStr: string } {
    // Argentina = UTC-3 (no DST) — usamos Intl para obtener la hora local correcta
    const now = new Date();
    const parts = new Intl.DateTimeFormat('en-CA', {
      timeZone: 'America/Argentina/Buenos_Aires',
      year: 'numeric', month: '2-digit', day: '2-digit',
      hour: '2-digit', minute: '2-digit', hour12: false,
    }).formatToParts(now);
    const get = (type: string) => parts.find(p => p.type === type)?.value || '00';
    return {
      dateStr: `${get('year')}-${get('month')}-${get('day')}`,
      timeStr: `${get('hour')}:${get('minute')}`,
    };
  }

  function isBookingPast(fecha: string, hora: string): boolean {
    const { dateStr, timeStr } = getNowArgentina();
    if (fecha < dateStr) return true;
    if (fecha === dateStr && hora < timeStr) return true;
    return false;
  }

  function filterOutPastBookings(bookings: Array<{fecha: string; hora: string; servicio: string}>) {
    return bookings.filter(b => !isBookingPast(b.fecha, b.hora));
  }

  function getTodayStr(): string {
    return getNowArgentina().dateStr;
  }

  function groupByClient(bookings: Array<{fecha: string; hora: string; servicio: string}>) {
    // Agrupar turnos del mismo día/cliente (misma fecha, horas consecutivas)
    // Para detectar multi-servicio: misma fecha, múltiples registros con horarios muy cercanos
    const groups: Record<string, typeof bookings> = {};
    bookings.forEach(b => {
      const key = b.fecha;
      if (!groups[key]) groups[key] = [];
      groups[key].push(b);
    });
    return groups;
  }

  function renderAdminBookings(tab = adminCurrentTab) {
    adminCurrentTab = tab;
    const bookingsContainer = document.getElementById("admin-bookings");
    const noBookings = document.getElementById("no-bookings");
    if (!bookingsContainer || !noBookings) return;

    const todayStr = getTodayStr();

    let filtered = [...adminAllBookings];
    if (tab === "today") {
      filtered = adminAllBookings.filter(b => b.fecha === todayStr);
    } else if (tab === "upcoming") {
      filtered = adminAllBookings.filter(b => b.fecha > todayStr);
    } else if (tab === "multi") {
      // Mostrar solo fechas con más de 1 turno
      const groups = groupByClient(adminAllBookings);
      filtered = adminAllBookings.filter(b => (groups[b.fecha]?.length ?? 0) > 1);
    }

    // Update tab active styles
    document.querySelectorAll(".admin-tab").forEach((t) => {
      const te = t as HTMLElement;
      const isActive = te.dataset.tab === tab;
      te.className = `admin-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${isActive ? 'bg-gray-900 text-white' : 'text-gray-500 hover:bg-gray-100'}`;
    });

    if (filtered.length === 0) {
      bookingsContainer.classList.add("hidden");
      noBookings.classList.remove("hidden");
      return;
    }

    bookingsContainer.classList.remove("hidden");
    noBookings.classList.add("hidden");

    // Group by date for display
    const byDate: Record<string, typeof filtered> = {};
    filtered.forEach(b => {
      if (!byDate[b.fecha]) byDate[b.fecha] = [];
      byDate[b.fecha].push(b);
    });

    const dayNames = ["Dom","Lun","Mar","Mié","Jue","Vie","Sáb"];
    const monthNames = ["Ene","Feb","Mar","Abr","May","Jun","Jul","Ago","Sep","Oct","Nov","Dic"];

    bookingsContainer.innerHTML = Object.entries(byDate)
      .sort(([a], [b]) => a.localeCompare(b))
      .map(([fecha, items]) => {
        const [y, mo, d] = fecha.split('-').map(Number);
        const dateObj = new Date(y, mo - 1, d);
        const dayLabel = fecha === todayStr
          ? '<span class="bg-gray-900 text-white text-[10px] px-2 py-0.5 rounded-full font-bold uppercase">Hoy</span>'
          : `<span class="text-xs text-gray-500">${dayNames[dateObj.getDay()]} ${d} ${monthNames[mo-1]}</span>`;

        const isMulti = items.length > 1;

        const itemsHtml = items
          .sort((a, b) => a.hora.localeCompare(b.hora))
          .map(b => `
            <div class="flex items-center justify-between gap-3 py-2.5 px-3 rounded-xl bg-white border border-gray-100 hover:border-gray-300 transition-all group">
              <div class="flex items-center gap-3 min-w-0">
                <div class="w-10 h-10 rounded-xl bg-gray-100 flex flex-col items-center justify-center shrink-0">
                  <span class="text-[10px] font-bold text-gray-500 leading-none">${b.hora.split(':')[0]}</span>
                  <span class="text-[9px] text-gray-400 leading-none">${b.hora.split(':')[1]}hs</span>
                </div>
                <div class="min-w-0">
                  <p class="font-semibold text-gray-800 text-sm leading-snug truncate">${b.servicio}</p>
                  <p class="text-xs text-gray-400">${b.hora} hs</p>
                </div>
              </div>
              <button
                class="remove-booking shrink-0 w-8 h-8 rounded-lg flex items-center justify-center text-gray-300 hover:text-red-500 hover:bg-red-50 transition-all opacity-0 group-hover:opacity-100"
                data-fecha="${b.fecha}" data-hora="${b.hora}"
                title="Eliminar turno"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
                </svg>
              </button>
            </div>
          `).join("");

        return `
          <div class="mb-4">
            <div class="flex items-center gap-2 mb-2 px-1">
              ${dayLabel}
              ${isMulti ? `<span class="bg-amber-100 text-amber-700 text-[10px] px-2 py-0.5 rounded-full font-bold">✦ ${items.length} servicios</span>` : ''}
            </div>
            <div class="space-y-1.5">${itemsHtml}</div>
          </div>
        `;
      }).join("");

    // Remove buttons — sin confirm, ya estás autenticado
    bookingsContainer.querySelectorAll(".remove-booking").forEach((btn) => {
      btn.addEventListener("click", async (e) => {
        const target = e.currentTarget as HTMLElement;
        const fecha = target.dataset.fecha || "";
        const hora = target.dataset.hora || "";
        // Animación de salida
        const row = target.closest(".flex.items-center.justify-between") as HTMLElement | null;
        if (row) {
          row.style.opacity = "0.4";
          row.style.pointerEvents = "none";
        }
        const ok = await removeBooking(fecha, hora);
        if (ok) {
          adminAllBookings = adminAllBookings.filter(b => !(b.fecha === fecha && b.hora === hora));
          updateAdminStats();
          renderAdminBookings(adminCurrentTab);
        } else {
          if (row) { row.style.opacity = "1"; row.style.pointerEvents = ""; }
          alert("Error al eliminar");
        }
      });
    });
  }

  function updateAdminStats() {
    const todayStr = getTodayStr();
    const todayCount = adminAllBookings.filter(b => b.fecha === todayStr).length;
    const upcomingCount = adminAllBookings.filter(b => b.fecha > todayStr).length;
    const groups = groupByClient(adminAllBookings);
    const multiCount = Object.values(groups).filter(g => g.length > 1).length;

    const el = (id: string) => document.getElementById(id);
    const statTotal = el("stat-total");
    const statUpcoming = el("stat-upcoming");
    const statMulti = el("stat-multi");
    if (statTotal) statTotal.textContent = String(todayCount);
    if (statUpcoming) statUpcoming.textContent = String(upcomingCount);
    if (statMulti) statMulti.textContent = String(multiCount);
  }

  async function showAdminPanel() {
    if (!adminAuthenticated) {
      const password = prompt("Contraseña de administrador:");
      if (password !== ADMIN_PASSWORD) {
        if (password !== null) alert("Contraseña incorrecta");
        return;
      }
      adminAuthenticated = true;
    }

    const panel = document.getElementById("admin-panel");
    const bookingsContainer = document.getElementById("admin-bookings");
    if (!panel || !bookingsContainer) return;

    panel.classList.remove("hidden");
    bookingsContainer.innerHTML = `
      <div class="flex flex-col items-center justify-center py-10 gap-3">
        <div class="w-8 h-8 border-2 border-gray-300 border-t-gray-800 rounded-full animate-spin"></div>
        <p class="text-sm text-gray-400">Cargando turnos...</p>
      </div>`;

    // Obtener turnos — filtrar solo los de días anteriores, los de hoy se muestran siempre
    const all = await getBookings();
    const { dateStr: todayStr } = getNowArgentina();
    adminAllBookings = all.filter(b => b.fecha >= todayStr);

    updateAdminStats();
    renderAdminBookings("all");

    // Reset tab UI
    document.querySelectorAll(".admin-tab").forEach((t) => {
      const te = t as HTMLElement;
      te.className = `admin-tab px-3 py-1.5 rounded-lg text-xs font-semibold transition-all ${te.dataset.tab === 'all' ? 'bg-gray-900 text-white' : 'text-gray-500 hover:bg-gray-100'}`;
    });
  }

  function hideAdminPanel() {
    document.getElementById("admin-panel")?.classList.add("hidden");
  }

  async function handleClearAllBookings() {
    if (confirm("¿Eliminar TODOS los turnos futuros?")) {
      const ok = await clearAllBookings();
      if (ok) {
        adminAllBookings = [];
        updateAdminStats();
        renderAdminBookings(adminCurrentTab);
      } else {
        alert("Error al limpiar");
      }
    }
  }

  // ========== EVENT LISTENERS ==========
  document.addEventListener("DOMContentLoaded", () => {
    // Botones "+" en las cards de servicio
    document.querySelectorAll(".service-add-btn").forEach((btn) => {
      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        const el = btn as HTMLElement;
        const discountStr = el.dataset.serviceDiscountPrice;
        addToCart({
          id: el.dataset.serviceId || "",
          name: el.dataset.serviceName || "",
          price: parseInt(el.dataset.servicePrice || "0"),
          discountPrice: discountStr ? parseInt(discountStr) : undefined,
          duration: el.dataset.serviceDuration || "",
        });
      });
    });

    // Botones del carrito
    document.getElementById("cart-clear")?.addEventListener("click", clearCart);
    document.getElementById("cart-checkout")?.addEventListener("click", () => {
      if (cart.length === 0) return;
      currentSlotIndex = 0;
      cartSlots = [];
      showSection("calendar");
    });

    // Volver
    document.getElementById("back-to-services")?.addEventListener("click", () => showSection("services"));
    document.getElementById("back-to-calendar")?.addEventListener("click", () => {
      cartSlots = [];
      currentSlotIndex = 0;
      showSection("calendar");
    });

    // Modal
    document.getElementById("cancel-booking")?.addEventListener("click", hideConfirmationModal);
    document.getElementById("confirm-booking")?.addEventListener("click", confirmBooking);
    document.getElementById("confirmation-modal")?.addEventListener("click", (e) => {
      if (e.target === e.currentTarget) hideConfirmationModal();
    });

    // Admin
    document.getElementById("open-admin")?.addEventListener("click", showAdminPanel);
    document.getElementById("close-admin")?.addEventListener("click", hideAdminPanel);
    document.getElementById("clear-all-bookings")?.addEventListener("click", handleClearAllBookings);
    document.getElementById("admin-panel")?.addEventListener("click", (e) => {
      if (e.target === e.currentTarget) hideAdminPanel();
    });

    // Admin tabs
    document.querySelectorAll(".admin-tab").forEach((tab) => {
      tab.addEventListener("click", () => {
        const tabKey = (tab as HTMLElement).dataset.tab || "all";
        renderAdminBookings(tabKey);
      });
    });
  });
</script>
