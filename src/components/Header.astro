---
// Header adaptativo + Drawer lateral + Progress bar + Custom scrollbar
---

<!-- Header -->
<header
    id="main-header"
    class="fixed top-0 left-0 right-0 z-[1000] transition-all duration-500 ease-out"
>
    <div id="header-inner" class="flex items-center justify-between px-4 md:px-6 transition-all duration-500 h-[80px]">

        <!-- Logo -->
        <a href="/" class="flex items-center gap-2 group">
            <img
                id="header-logo"
                src="/logo.avif"
                alt="KMZ Studio"
                class="w-[60px] md:w-[70px] transition-all duration-500 group-hover:scale-110"
            />
        </a>

        <!-- Navegación Desktop con underline animado -->
        <nav class="hidden lg:flex items-center gap-1">
            <a href="#servicios" class="nav-link relative px-4 py-2 text-white/90 hover:text-white font-medium transition-all duration-300">
                Turnos
            </a>
            <a href="#ubicacion" class="nav-link relative px-4 py-2 text-white/90 hover:text-white font-medium transition-all duration-300">
                Ubicación
            </a>
            <a href="#informacion" class="nav-link relative px-4 py-2 text-white/90 hover:text-white font-medium transition-all duration-300">
                Info
            </a>
        </nav>

        <!-- Botones de redes + Hamburger -->
        <div class="flex items-center gap-2">
            <!-- WhatsApp -->
            <a
                href="https://wa.me/5492226532910"
                target="_blank"
                class="social-btn flex items-center justify-center w-10 h-10 rounded-full bg-black/20 hover:bg-green-500 backdrop-blur-sm transition-all duration-300 hover:scale-110"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
                    <path d="M9 10a.5 .5 0 0 0 1 0v-1a.5 .5 0 0 0 -1 0v1a5 5 0 0 0 5 5h1a.5 .5 0 0 0 0 -1h-1a.5 .5 0 0 0 0 1"></path>
                </svg>
            </a>

            <!-- Instagram -->
            <a
                href="https://www.instagram.com/kmz.barberia"
                target="_blank"
                class="social-btn flex items-center justify-center w-10 h-10 rounded-full bg-black/20 hover:bg-[#C72785] backdrop-blur-sm transition-all duration-300 hover:scale-110"
            >
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"></path>
                    <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
                    <path d="M16.5 7.5v.01"></path>
                </svg>
            </a>

            <!-- Botón hamburger animado -->
            <button
                id="menu-toggle"
                class="lg:hidden flex items-center justify-center w-10 h-10 rounded-full bg-black/20 hover:bg-black/40 backdrop-blur-sm transition-all duration-300"
                aria-label="Menú"
            >
                <div id="hamburger" class="hamburger-icon">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
            </button>
        </div>
    </div>
</header>

<!-- Barra de progreso de scroll -->
<div id="scroll-progress" class="fixed left-0 z-[999] h-[2px] opacity-0 transition-opacity duration-300" style="top: 80px; width: 0%;">
</div>

<!-- Overlay del drawer -->
<div id="drawer-overlay" class="fixed inset-0 z-[1001] hidden opacity-0 transition-opacity duration-300 pointer-events-none bg-black/60 backdrop-blur-sm"></div>

<!-- Drawer lateral derecho -->
<div id="drawer" class="fixed top-0 right-0 z-[1002] h-full w-[280px] translate-x-full transition-transform duration-500 flex flex-col" style="transition-timing-function: cubic-bezier(0.32, 0.72, 0, 1);">
    <!-- Fondo del drawer -->
    <div class="absolute inset-0 bg-black/90 backdrop-blur-xl border-l border-white/10"></div>

    <!-- Contenido -->
    <div class="relative flex flex-col h-full">
        <!-- Close button -->
        <div class="flex justify-end p-4">
            <button id="drawer-close" class="flex items-center justify-center w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 transition-all duration-300">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M18 6L6 18"></path>
                    <path d="M6 6l12 12"></path>
                </svg>
            </button>
        </div>

        <!-- Nav links con stagger animation -->
        <nav class="flex flex-col px-6 gap-1 mt-4">
            <a href="#servicios" class="drawer-link flex items-center gap-3 px-4 py-4 text-white text-lg font-medium rounded-xl hover:bg-white/10 transition-all duration-300 opacity-0 translate-x-8" style="transition-delay: 0ms;">
                <span class="text-white/40">01</span>
                Reservar Turno
            </a>
            <a href="#ubicacion" class="drawer-link flex items-center gap-3 px-4 py-4 text-white text-lg font-medium rounded-xl hover:bg-white/10 transition-all duration-300 opacity-0 translate-x-8" style="transition-delay: 60ms;">
                <span class="text-white/40">02</span>
                Ubicación
            </a>
            <a href="#informacion" class="drawer-link flex items-center gap-3 px-4 py-4 text-white text-lg font-medium rounded-xl hover:bg-white/10 transition-all duration-300 opacity-0 translate-x-8" style="transition-delay: 120ms;">
                <span class="text-white/40">03</span>
                Información
            </a>

            <div class="border-t border-white/10 my-4"></div>

            <!-- Social buttons -->
            <div class="drawer-link flex items-center gap-3 opacity-0 translate-x-8" style="transition-delay: 200ms;">
                <a href="https://wa.me/5492226532910" target="_blank" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-green-600 hover:bg-green-500 text-white rounded-xl transition-all duration-300 font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M3 21l1.65 -3.8a9 9 0 1 1 3.4 2.9l-5.05 .9"></path>
                    </svg>
                    WhatsApp
                </a>
                <a href="https://www.instagram.com/kmz.barberia" target="_blank" class="flex-1 flex items-center justify-center gap-2 px-4 py-3 bg-[#C72785] hover:bg-[#a01f6b] text-white rounded-xl transition-all duration-300 font-medium">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <path d="M4 8a4 4 0 0 1 4 -4h8a4 4 0 0 1 4 4v8a4 4 0 0 1 -4 4h-8a4 4 0 0 1 -4 -4z"></path>
                        <path d="M9 12a3 3 0 1 0 6 0a3 3 0 0 0 -6 0"></path>
                    </svg>
                    Instagram
                </a>
            </div>
        </nav>

        <!-- Copyright al fondo -->
        <div class="mt-auto p-6">
            <p class="text-white/30 text-xs text-center">KMZ Studio © 2024</p>
        </div>
    </div>
</div>

<!-- Custom scrollbar track -->
<div id="scroll-track" class="fixed right-[2px] z-[998] w-[5px] rounded-full opacity-0 transition-opacity duration-300 pointer-events-none" style="top: 80px; bottom: 80px;">
    <div id="scroll-thumb" class="absolute w-full rounded-full cursor-pointer pointer-events-auto transition-transform duration-150 ease-out" style="height: 60px; top: 0;">
    </div>
</div>

<script>
    // ========== ELEMENTS ==========
    const header = document.getElementById('main-header')!;
    const headerInner = document.getElementById('header-inner')!;
    const headerLogo = document.getElementById('header-logo')!;
    const menuToggle = document.getElementById('menu-toggle')!;
    const hamburger = document.getElementById('hamburger')!;
    const drawer = document.getElementById('drawer')!;
    const drawerOverlay = document.getElementById('drawer-overlay')!;
    const drawerClose = document.getElementById('drawer-close')!;
    const drawerLinks = document.querySelectorAll('.drawer-link');
    const scrollProgress = document.getElementById('scroll-progress')!;
    const scrollTrack = document.getElementById('scroll-track')!;
    const scrollThumb = document.getElementById('scroll-thumb')!;

    let isScrolled = false;
    let isDrawerOpen = false;
    let scrollThumbTimeout: ReturnType<typeof setTimeout> | null = null;
    let isDragging = false;
    let dragStartY = 0;
    let dragStartScrollY = 0;
    let hasScrolledOnce = false;

    // ========== 1. HEADER ADAPTATIVO ==========
    function updateHeader() {
        const scrollY = window.scrollY;
        const shouldBeScrolled = scrollY > 60;

        if (shouldBeScrolled !== isScrolled) {
            isScrolled = shouldBeScrolled;

            if (isScrolled) {
                header.style.backdropFilter = 'blur(16px) saturate(1.4)';
                header.style.webkitBackdropFilter = 'blur(16px) saturate(1.4)';
                header.style.backgroundColor = 'rgba(55, 55, 55, 0.75)';
                header.style.boxShadow = '0 1px 20px rgba(0,0,0,0.15)';
                headerInner.classList.remove('h-[80px]');
                headerInner.classList.add('h-[60px]');
                headerLogo.classList.remove('w-[60px]', 'md:w-[70px]');
                headerLogo.classList.add('w-[45px]', 'md:w-[50px]');
                scrollProgress.style.top = '60px';
            } else {
                header.style.backdropFilter = 'none';
                header.style.webkitBackdropFilter = 'none';
                header.style.backgroundColor = 'transparent';
                header.style.boxShadow = 'none';
                headerInner.classList.remove('h-[60px]');
                headerInner.classList.add('h-[80px]');
                headerLogo.classList.remove('w-[45px]', 'md:w-[50px]');
                headerLogo.classList.add('w-[60px]', 'md:w-[70px]');
                scrollProgress.style.top = '80px';
            }
        }
    }

    // ========== 2. DRAWER LATERAL ==========
    function openDrawer() {
        isDrawerOpen = true;
        drawer.classList.remove('translate-x-full');
        drawer.classList.add('translate-x-0');
        drawerOverlay.classList.remove('hidden', 'pointer-events-none');
        setTimeout(() => {
            drawerOverlay.classList.remove('opacity-0');
            drawerOverlay.classList.add('opacity-100');
        }, 10);
        hamburger.classList.add('is-active');
        document.body.style.overflow = 'hidden';

        // Stagger animation para los links
        drawerLinks.forEach((link) => {
            const el = link as HTMLElement;
            setTimeout(() => {
                el.classList.remove('opacity-0', 'translate-x-8');
                el.classList.add('opacity-100', 'translate-x-0');
            }, 150 + parseInt(el.style.transitionDelay || '0'));
        });
    }

    function closeDrawer() {
        isDrawerOpen = false;
        drawer.classList.remove('translate-x-0');
        drawer.classList.add('translate-x-full');
        drawerOverlay.classList.remove('opacity-100');
        drawerOverlay.classList.add('opacity-0');
        hamburger.classList.remove('is-active');
        document.body.style.overflow = '';

        setTimeout(() => {
            drawerOverlay.classList.add('hidden', 'pointer-events-none');
            // Reset links para la próxima apertura
            drawerLinks.forEach((link) => {
                const el = link as HTMLElement;
                el.classList.add('opacity-0', 'translate-x-8');
                el.classList.remove('opacity-100', 'translate-x-0');
            });
        }, 500);
    }

    menuToggle.addEventListener('click', () => {
        if (isDrawerOpen) closeDrawer();
        else openDrawer();
    });
    drawerOverlay.addEventListener('click', closeDrawer);
    drawerClose.addEventListener('click', closeDrawer);
    drawerLinks.forEach(link => {
        if (link.tagName === 'A') link.addEventListener('click', closeDrawer);
        link.querySelectorAll('a').forEach(a => a.addEventListener('click', closeDrawer));
    });

    // ========== 3. BARRA DE PROGRESO ==========
    function updateScrollProgress() {
        const scrollY = window.scrollY;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollHeight <= 0) return;

        const pct = (scrollY / scrollHeight) * 100;
        scrollProgress.style.width = `${pct}%`;

        if (scrollY > 0) {
            if (!hasScrolledOnce) {
                hasScrolledOnce = true;
                scrollProgress.classList.remove('opacity-0');
                scrollProgress.classList.add('opacity-100');
            }
        } else {
            scrollProgress.classList.remove('opacity-100');
            scrollProgress.classList.add('opacity-0');
            hasScrolledOnce = false;
        }
    }

    // ========== 4. SCROLLBAR CUSTOM ==========
    function updateScrollThumb() {
        const scrollY = window.scrollY;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        if (scrollHeight <= 0) return;

        const trackHeight = scrollTrack.clientHeight;
        const thumbH = Math.max(30, (window.innerHeight / document.documentElement.scrollHeight) * trackHeight);
        scrollThumb.style.height = `${thumbH}px`;

        const maxThumbTop = trackHeight - thumbH;
        const thumbTop = (scrollY / scrollHeight) * maxThumbTop;
        scrollThumb.style.top = `${thumbTop}px`;

        // Mostrar con spring animation
        scrollTrack.classList.remove('opacity-0');
        scrollTrack.classList.add('opacity-100');
        scrollThumb.classList.add('thumb-spring');
        setTimeout(() => scrollThumb.classList.remove('thumb-spring'), 400);

        // Auto-ocultar a los 1.2s
        if (scrollThumbTimeout) clearTimeout(scrollThumbTimeout);
        scrollThumbTimeout = setTimeout(() => {
            if (!isDragging) {
                scrollTrack.classList.remove('opacity-100');
                scrollTrack.classList.add('opacity-0');
            }
        }, 1200);
    }

    // Drag del thumb
    scrollThumb.addEventListener('mousedown', (e) => {
        isDragging = true;
        dragStartY = e.clientY;
        dragStartScrollY = window.scrollY;
        scrollThumb.classList.add('is-dragging');
        document.body.style.userSelect = 'none';
        document.body.style.cursor = 'grabbing';
        e.preventDefault();
    });

    window.addEventListener('mousemove', (e) => {
        if (!isDragging) return;
        const trackHeight = scrollTrack.clientHeight;
        const thumbH = scrollThumb.clientHeight;
        const maxThumbTop = trackHeight - thumbH;
        const scrollHeight = document.documentElement.scrollHeight - window.innerHeight;
        const deltaY = e.clientY - dragStartY;
        const scrollDelta = (deltaY / maxThumbTop) * scrollHeight;
        window.scrollTo(0, dragStartScrollY + scrollDelta);
    });

    window.addEventListener('mouseup', () => {
        if (!isDragging) return;
        isDragging = false;
        scrollThumb.classList.remove('is-dragging');
        document.body.style.userSelect = '';
        document.body.style.cursor = '';
    });

    // ========== SCROLL HANDLER ==========
    function onScroll() {
        updateHeader();
        updateScrollProgress();
        updateScrollThumb();
    }

    window.addEventListener('scroll', onScroll, { passive: true });

    // Inicializar
    updateHeader();
    updateScrollProgress();
</script>
