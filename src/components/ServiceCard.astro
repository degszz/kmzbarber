---
interface Props {
  id: string;
  name: string;
  price: number;
  duration: string;
  description?: string;
}

const { id, name, price, duration, description } = Astro.props;
---

<div
  class="service-card group cursor-pointer rounded-xl shadow-md p-5 bg-gradient-to-br from-gray-50 to-gray-100
         border-2 border-transparent
         flex flex-col transition-all duration-300 ease-out
         hover:scale-[1.03] hover:shadow-xl hover:border-gray-400
         data-[selected=true]:border-gray-800 data-[selected=true]:bg-gradient-to-br data-[selected=true]:from-gray-200 data-[selected=true]:to-gray-300"
  data-service-id={id}
  data-service-name={name}
  data-service-price={price}
  data-service-duration={duration}
>
  <div class="flex justify-between items-start mb-2">
    <h3 class="text-lg font-semibold text-gray-800 group-hover:text-gray-900 transition-colors pr-2">
      {name}
    </h3>
    <!-- Indicador de cantidad en carrito -->
    <div class="service-cart-badge hidden items-center justify-center min-w-[24px] h-6 px-1.5 rounded-full bg-gray-800 text-white text-xs font-bold">
      0
    </div>
  </div>

  {description && (
    <p class="text-sm text-gray-600 mb-3">{description}</p>
  )}

  <div class="mt-auto flex justify-between items-end">
    <span class="text-2xl font-bold text-gray-900">
      ${price.toLocaleString('es-AR')}
    </span>
    <div class="flex items-center gap-2">
      <span class="text-sm text-gray-500 flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
        {duration}
      </span>
      <!-- Botón agregar al carrito -->
      <button
        class="service-add-btn flex items-center justify-center w-8 h-8 rounded-full bg-gray-800 hover:bg-gray-600 text-white transition-all duration-200 hover:scale-110 shadow-md"
        data-service-id={id}
        data-service-name={name}
        data-service-price={price}
        data-service-duration={duration}
        title="Agregar al carrito"
      >
        <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
          <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
        </svg>
      </button>
    </div>
  </div>
</div>
